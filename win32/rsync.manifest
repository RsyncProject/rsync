<?xml version="1.0" encoding="UTF-8" standalone="yes"?>
<!--
  Makes the process use UTF-8 as its active code page (Windows 10 1903+).

  rsync exchanges file names as raw bytes and the peer is normally a UTF-8
  Unix host, so this is exactly the encoding we want. It also means the
  narrow Win32 calls in win32/*.c (CreateFileA, FindFirstFileA, _stat64 and
  friends) accept and return UTF-8, letting names outside the legacy ANSI
  code page (Japanese, emoji, accented Latin) round-trip correctly.

  Copyright (C) 2026 Max Vilimpoc, rsync CMake/Windows port.
  Distributed under the same GPL-3.0-or-later terms as the rest of rsync.
-->
<assembly xmlns="urn:schemas-microsoft-com:asm.v1" manifestVersion="1.0">
  <assemblyIdentity type="win32" name="rsync" version="1.0.0.0"/>
  <application xmlns="urn:schemas-microsoft-com:asm.v3">
    <windowsSettings>
      <activeCodePage xmlns="http://schemas.microsoft.com/SMI/2019/WindowsSettings">UTF-8</activeCodePage>
      <longPathAware xmlns="http://schemas.microsoft.com/SMI/2016/WindowsSettings">true</longPathAware>
    </windowsSettings>
  </application>
</assembly>
