/*
 * VS_VERSION_INFO for rsync.exe -- what Explorer's Details tab, "Product
 * version" in the file properties, and most inventory tooling read.
 *
 * Generated by CMake from this template so the numbers cannot drift from
 * version.h, which is where rsync keeps its version and where configure.ac
 * greps it from.
 *
 * Both version strings name the commit -- "3.5.0-g8cfbe798" -- because
 * builds come off git HEAD routinely and a bare release number cannot tell
 * two of them apart.  Explorer's "File version" is the one field that cannot
 * show it: Explorer reads that from the binary FILEVERSION, which is four
 * 16-bit numbers and has no room for a rev.  That field carries the commit
 * count instead ("3.5.0.40"), so it still advances with every commit and
 * still orders two builds correctly.
 *
 * The 32-bit build is rsync-x86.exe, so OriginalFilename and the description
 * follow the rename -- everything else about the two builds is identical, and
 * the properties dialog is where someone looks to tell them apart.
 *
 * Only rsync.exe gets this; the C test helpers share rsync.manifest but must
 * not claim to be rsync.
 *
 * Copyright (C) 2026 Max Vilimpoc, rsync CMake/Windows port.
 * Distributed under the same GPL-3.0-or-later terms as the rest of rsync.
 */

#include <winver.h>

VS_VERSION_INFO VERSIONINFO

	FILEVERSION    @RSYNC_RC_FILEVERSION@
	PRODUCTVERSION @RSYNC_RC_FILEVERSION@
	FILEFLAGSMASK  VS_FFI_FILEFLAGSMASK
	FILEFLAGS      @RSYNC_RC_FILEFLAGS@
	FILEOS         VOS_NT_WINDOWS32
	FILETYPE       VFT_APP
	FILESUBTYPE    VFT2_UNKNOWN
BEGIN
	BLOCK "StringFileInfo"
	BEGIN

		BLOCK "040904b0"
		BEGIN
			VALUE "CompanyName",      "The rsync project"
			VALUE "FileDescription",  "@RSYNC_RC_DESCRIPTION@"
			VALUE "FileVersion",      "@RSYNC_RC_VERSION_DISPLAY@"
			VALUE "InternalName",     "rsync"
			VALUE "OriginalFilename", "@RSYNC_RC_ORIGINAL_FILENAME@"
			VALUE "ProductName",      "rsync"
			VALUE "ProductVersion",   "@RSYNC_RC_VERSION_DISPLAY@"
			VALUE "LegalCopyright",   "Copyright (C) 1996-2026 by Andrew Tridgell, Wayne Davison, and others. GPL-3.0-or-later."
			VALUE "Comments",         "Native Windows build of rsync @RSYNC_VERSION_STRING@ (@RSYNC_WIN_ARCH@). CMake/Windows port by Max Vilimpoc. https://rsync.samba.org/"
		END
	END
	BLOCK "VarFileInfo"
	BEGIN

		VALUE "Translation", 0x409, 1200
	END
END
