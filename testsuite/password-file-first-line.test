#! /bin/sh

. "$suitedir/rsync.fns"

python3 - "$RSYNC" "$scratchdir" <<'PY'
import os
import shlex
import shutil
import subprocess
import sys

rsync = shlex.split(sys.argv[1])
base = os.path.join(sys.argv[2], "password-file")
source = os.path.join(base, "source")
destination = os.path.join(base, "destination")
shutil.rmtree(base, ignore_errors=True)
os.makedirs(source)
os.makedirs(destination)

with open(os.path.join(source, "payload"), "w") as stream:
    stream.write("regression test\n")

secrets = os.path.join(base, "secrets")
with open(secrets, "wb") as stream:
    stream.write(b"tuser:secretpass\n")
os.chmod(secrets, 0o600)

config = os.path.join(base, "rsyncd.conf")
with open(config, "w") as stream:
    if os.geteuid() == 0:
        stream.write("uid = 0\n")
        stream.write("gid = 0\n")
    stream.write("use chroot = no\n")
    stream.write("[auth]\n")
    stream.write("path = %s\n" % destination)
    stream.write("read only = no\n")
    stream.write("auth users = tuser\n")
    stream.write("secrets file = %s\n" % secrets)

connect = rsync + ["--config=" + config, "--daemon"]
base_env = os.environ.copy()
base_env["RSYNC_CONNECT_PROG"] = " ".join(shlex.quote(arg) for arg in connect)

cases = (
    ("lf", b"secretpass\nignored\n", True),
    ("crlf", b"secretpass\r\nignored\r\n", True),
    ("empty", b"", False),
    ("empty-first-line", b"\nsecretpass\n", False),
    ("no-final-newline", b"secretpass", True),
)

for source_kind in ("file", "stdin"):
    for name, contents, succeeds in cases:
        shutil.rmtree(destination)
        os.makedirs(destination)
        arguments = ["-a", source + "/", "tuser@localhost::auth/"]
        if source_kind == "file":
            password_file = os.path.join(base, name + ".password")
            with open(password_file, "wb") as stream:
                stream.write(contents)
            os.chmod(password_file, 0o600)
            arguments.insert(1, "--password-file=" + password_file)
            stdin = None
        else:
            arguments.insert(1, "--password-file=-")
            stdin = contents

        env = base_env.copy()
        env["RSYNC_PASSWORD"] = "wrong-fallback" if succeeds else "secretpass"
        result = subprocess.run(
            rsync + arguments,
            input=stdin,
            stdout=subprocess.DEVNULL,
            stderr=subprocess.PIPE,
            timeout=20,
            env=env,
        )
        if (result.returncode == 0) != succeeds:
            raise SystemExit(
                "%s/%s returned %d: %r"
                % (source_kind, name, result.returncode, result.stderr)
            )
        if not succeeds:
            if result.returncode != 1 or b"failed to read a password" not in result.stderr:
                raise SystemExit(
                    "%s/%s did not report a password read failure"
                    % (source_kind, name)
                )
        elif not os.path.isfile(os.path.join(destination, "payload")):
            raise SystemExit("%s/%s did not transfer the payload" % (source_kind, name))
PY
status=$?

case $status in
0) ;;
*) test_fail "Password-file first-line handling is inconsistent" ;;
esac
